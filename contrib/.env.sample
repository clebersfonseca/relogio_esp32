# Configurações de Conexão Wi-Fi
WIFI_SSID="Nome_Da_Sua_Rede_Wifi"
WIFI_PASS="Sua_Senha_Secreta_Wifi"

# Configurações de Fuso Horário e Servidores NTP
# Fuso horário em segundos (-3 horas = -10800 para Horário de Brasília)
GMT_OFFSET_SEC="-10800"
DAYLIGHT_OFFSET_SEC="0"

# Servidores NTP (prioridade para os servidores brasileiros NTP.br)
NTP_SERVER1="a.st1.ntp.br"
NTP_SERVER2="b.st1.ntp.br"
NTP_SERVER3="pool.ntp.org"

# Intervalo de ressincronização em milissegundos (3600000 ms = 1 hora)
NTP_SYNC_INTERVAL_MS="3600000"

# Localização para a previsão do tempo (opcional; sem isto usa geolocalização por IP)
LATITUDE="-23.55"
LONGITUDE="-46.63"
CITY_NAME="Sao Paulo"

# Assistente de IA (chave gratuita em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Definindo o modelo de TTS (Text-to-Speech) para o assistente de IA
GEMINI_TTS_MODEL=gemini-tts-1.0
